  --ar="$TOOLCHAIN/bin/llvm-ar" \
  --ranlib="$TOOLCHAIN/bin/llvm-ranlib" \
  --strip="$TOOLCHAIN/bin/llvm-strip" \
  --nm="$TOOLCHAIN/bin/llvm-nm" \
  --enable-cross-compile \
  --enable-pic \
  --disable-shared \
  --enable-static \
  --disable-programs \
  --disable-doc \
  --disable-debug \
  --disable-network \
  --disable-iconv \
  --disable-avdevice \
  --disable-avfilter \
  --disable-swscale \
  --disable-swresample \
  --disable-decoders \
  --disable-encoders \
  --disable-hwaccels \
  --disable-parsers \
  --disable-bsfs \
  --disable-demuxers \
  --disable-muxers \
  --disable-protocols \
  --enable-demuxer=flac \
  --enable-demuxer=mov \
  --enable-demuxer=ogg \
  --enable-demuxer=matroska \
  --enable-demuxer=mp3 \
  --enable-demuxer=wav \
  --enable-muxer=flac \
  --enable-muxer=mov \
  --enable-muxer=ogg \
  --enable-muxer=matroska \
  --enable-muxer=mp3 \
  --enable-muxer=wav \
  --enable-protocol=file \
  --enable-parser=flac \
  --enable-parser=mpegaudio \
  --optflags="-Os" \
  --extra-cflags="-ffunction-sections -fdata-sections" \
  --extra-ldflags="-Wl,--gc-sections"

make -j$(nproc)
make install

cd build/android-arm64/lib

$TOOLCHAIN/bin/aarch64-linux-android${API}-clang \
  -shared \
  -Wl,-soname,libthan_media_tag.so \
  -Wl,-Bsymbolic \
  -Wl,--whole-archive \
  libavformat.a \
  libavcodec.a \
  libavutil.a \
  -Wl,--no-whole-archive \
  -lz \
  -lm \
  -o libthan_media_tag.so

$TOOLCHAIN/bin/llvm-strip --strip-unneeded libthan_media_tag.so


