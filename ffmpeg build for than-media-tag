./configure \
  --prefix="$PWD/build" \
  --enable-pic \
  --disable-shared \
  --enable-static \
  --disable-everything \
  --disable-programs \
  --disable-doc \
  --disable-debug \
  --disable-network \
  --disable-autodetect \
  --disable-avdevice \
  --disable-avfilter \
  --disable-swresample \
  --disable-swscale \
  --disable-bsfs \
  --disable-decoders \
  --disable-encoders \
  --disable-hwaccels \
  --disable-parsers \
  --enable-avutil \
  --enable-avcodec \
  --enable-avformat \
  --enable-protocol=file \
  --enable-parser=mpegaudio \
  --enable-parser=flac \
  --enable-demuxer=mov \
  --enable-demuxer=matroska \
  --enable-demuxer=ogg \
  --enable-demuxer=mp3 \
  --enable-demuxer=flac \
  --enable-demuxer=wav \
  --enable-muxer=mov \
  --enable-muxer=matroska \
  --enable-muxer=ogg \
  --enable-muxer=mp3 \
  --enable-muxer=flac \
  --enable-muxer=wav

make -j$(nproc)
make install

ls -lh build/lib/*.a

cd build/lib

gcc -shared \
  -Wl,-soname,libthan_media_tag.so \
  -Wl,-Bsymbolic \
  -Wl,--whole-archive \
  libavformat.a \
  libavcodec.a \
  libavutil.a \
  -Wl,--no-whole-archive \
  -lm \
  -lpthread \
  -ldl \
  -o libthan_media_tag.so


strip --strip-unneeded libthan_media_tag.so


ls -lh libthan_media_tag.so


nm -D --defined-only libthan_media_tag.so | grep avformat_open_input


